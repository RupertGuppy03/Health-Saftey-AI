# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit real keys.

# Unstructured API — PDF extraction (src/ingestion/extract.py)
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=

# OpenAI API — embeddings (src/embeddings/chunking_script_v2.py)
# Note: the code also accepts the SDK's standard OPENAI_API_KEY name.
OPEN_AI_API_KEY=

# FastAPI backend — where the chat interface sends questions (src/ui/responder.py).
# Optional. Leave it unset unless the backend is somewhere other than the default
# http://localhost:8000. Not a secret; it is a URL, not a credential.
# HS_API_BASE_URL=
