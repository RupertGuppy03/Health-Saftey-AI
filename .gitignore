# --- Secrets ---
.env
.streamlit/secrets.toml

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Virtual environments ---
.venv/
venv/
env/

# --- Vector store ---
# The live store is never committed: Chroma rewrites chroma.sqlite3 just from
# reading it, so tracking it would leave everyone with a permanently dirty 46MB
# binary that git cannot merge. The team shares the store as a snapshot archive
# (vectorstore-snapshot.tar.gz, committed) which is unpacked into this folder.
vectorstore/*
!vectorstore/README.md

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
